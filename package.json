{
  "name": "cli-project",
  "version": "1.0.0",
  "description": "A Node.js CLI project with pnpm workspace and oclif",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "optimus": "./bin/dev.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --loader ts-node/esm src/index.ts",
    "start": "node bin/dev.js",
    "optimus": "node bin/dev.js",
    "chat": "node bin/dev.js chat",
    "config-cli": "node bin/dev.js config",
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cli",
    "oclif"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^5.5.0",
    "@inquirer/search": "^3.1.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@oclif/core": "^4.8.0",
    "@oclif/plugin-help": "^6.0.0",
    "@oclif/plugin-version": "^2.0.0",
    "axios": "^1.13.5",
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "cli-highlight": "^2.1.11",
    "cli-spinners": "^2.9.2",
    "diff": "^5.2.0",
    "dotenv": "^16.3.1",
    "form-data": "^4.0.5",
    "glob": "^13.0.6",
    "ink": "^5.0.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "litellm": "^0.12.0",
    "log-update": "^6.0.0",
    "marked": "^11.2.0",
    "marked-terminal": "^6.2.0",
    "node-record-lpcm16": "^1.0.1",
    "ora": "^8.0.1",
    "prompts": "^2.4.2",
    "react": "^18.2.0",
    "simple-git": "^3.31.1",
    "string-to-stream": "^3.0.1",
    "strip-ansi": "^7.1.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^18.3.5",
    "@types/react-reconciler": "^0.28.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "oclif": {
    "bin": "optimus",
    "dirname": "optimus",
    "commands": "dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-version"
    ]
  }
}